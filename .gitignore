# ═══════════════════════════════════════════════════════
#  VeeTrack — .gitignore
#  Single root file covering both frontend and backend.
# ═══════════════════════════════════════════════════════

# ── Environment (NEVER commit secrets) ──────────────────
.env
.env.local
.env.*.local

# ── Python ───────────────────────────────────────────────
veetrack-backend/venv/
veetrack-backend/__pycache__/
veetrack-backend/**/__pycache__/
veetrack-backend/**/*.pyc
veetrack-backend/**/*.pyo
*.egg-info/
.pytest_cache/

# ── Node.js ──────────────────────────────────────────────
node_modules/
veetrack-frontend/node_modules/

# ── Next.js ──────────────────────────────────────────────
veetrack-frontend/.next/
veetrack-frontend/out/
veetrack-frontend/.vercel/

# ── Build outputs ────────────────────────────────────────
dist/
build/

# ── AI Model caches ──────────────────────────────────────
.cache/
*.pt
*.bin
~/.cache/huggingface/

# ── Logs ─────────────────────────────────────────────────
*.log
/tmp/ollama.log
logs/

# ── OS & editor ──────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Stray test/debug files ───────────────────────────────
response.json
test_report.pdf

# ── Docker volumes ───────────────────────────────────────
redis_data/
model_cache/

Check/
.veetrack_cache/

# VeeTrack — Environment Configuration Template
# Copy this to .env and fill in values

# ── Cache (DiskCache + SQLite used automatically) ─────────
# No Redis URL required.

# ── FastAPI Backend ───────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ── External APIs (Optional for production) ────────
NEWSDATA_API_KEY=""
ALPHAVANTAGE_API_KEY=""

# ── Ollama (local LLM — fallback if not running) ─────────────────
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull model: ollama pull gemma2:2b
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma2:2b

# ── NewsData.io backup source (optional, free 200 req/day) ───────
NEWSDATA_API_KEY=

# ── Email delivery for daily PDF reports (optional) ──────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_FROM_EMAIL=reports@veetechnologies.com

# ── Google News ───────────────────────────────────────────────────
GOOGLE_NEWS_REGION=IN
GOOGLE_NEWS_LANGUAGE=en-IN

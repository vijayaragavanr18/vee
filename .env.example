# VeeTrack — Environment Configuration Template
# Copy this to .env and fill in values

# ── Database (PostgreSQL via asyncpg) ─────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/veetrack

# ── Redis (Celery Broker & Rate Limiting) ───────
REDIS_URL=redis://localhost:6379/0
CELERY_CONCURRENCY=4

# ── FastAPI Backend ───────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ── External APIs (Ingestion Sources) ────────
NEWSDATA_API_KEY="pub_ce1e18fda43b415d8afedc35c028a7f6"
FREENEWS_API_KEY="12cdff63a0e543dfab3c80c47ef43335"
CURRENTS_API_KEY="SxcM-1NEJtxO2aRuVB9WwdncnfncfLCI-5--PljCwzwiwlkb"
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# ── vLLM (local LLM — inference engine) ─────────────────
VLLM_URL=http://localhost:8000/v1/chat/completions
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ
# OPENROUTER_API_KEY=

# ── NewsData.io backup source (optional, free 200 req/day) ───────
NEWSDATA_API_KEY=

# ── Email delivery for daily PDF reports (optional) ──────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_FROM_EMAIL=reports@veetechnologies.com

# ── Google News ───────────────────────────────────────────────────
GOOGLE_NEWS_REGION=IN
GOOGLE_NEWS_LANGUAGE=en-IN
